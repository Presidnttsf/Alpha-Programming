const readline = require("readline");
const rl = readline.createInterface({ input: process.stdin, output: process.stdout });

// Menu (like the struct array in C)
const menu = [
  { name: "Biryani",    price: 200 },
  { name: "Roti",       price: 20 },
  { name: "Korma",      price: 150 },
  { name: "Cold Drink", price: 50 },
  { name: "Lassi",      price: 70 },
  { name: "Ice Cream",  price: 100 },
  { name: "Steam Rice", price: 100 },
  { name: "Veg Mix",    price: 120 },
];

const orders = [];   // grows dynamically, no fixed size needed in JS
let grandTotal = 0;

function ask(question) {
  return new Promise((resolve) => rl.question(question, resolve));
}

function showMenu() {
  console.log("\n========== MENU ==============");
  console.log("S.No    ITEMS           PRICE");
  console.log("==============================");
  menu.forEach((item, i) => {
    console.log(`${i + 1}.      ${item.name.padEnd(15)} Rs. ${item.price}`);
  });
  console.log("==============================");
}

async function main() {
  showMenu();

  while (true) {
    const choiceStr = await ask("\nEnter item number (0 to stop): ");
    const choice = parseInt(choiceStr, 10);

    if (choice > menu.length) {
      console.log("Invalid input");
      break;
    }
    if (choice === 0) break;

    const quantityStr = await ask("Enter quantity: ");
    const quantity = parseInt(quantityStr, 10);

    const item = menu[choice - 1];
    const total = item.price * quantity;

    // Equivalent of orders[count] = menu[choice-1]; orders[count].quantity = ...
    orders.push({ name: item.name, price: item.price, quantity, total });

    grandTotal += total;
    // No manual count++ needed — push() grows the array for us
  }

  console.log("\n===== BILL =====");
  orders.forEach((o) => {
    console.log(`${o.name} x ${o.quantity} = Rs.${o.total.toFixed(2)}`);
  });
  console.log("-----------------");
  console.log(`Grand Total = Rs.${grandTotal.toFixed(2)}`);

  rl.close();
}

main();
